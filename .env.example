# Funergy+ の秘密の値の「名前」だけの一覧です。値は書きません（このリポジトリは公開です）。
# 本物の値は Supabase の Edge Functions › Secrets にだけあり、Moto さんが入れます。
# この .env.example を Supabase へそのまま読み込むことはありません。名前と使う所を確かめるための表です。
# 名前は supabase/functions と deploy/ の中から集めました（2026-11-15）。関数を足したときはここにも足してください。

# ── Supabase が関数に自動で渡すもの（Secrets に入れなくてよい）──
# bonus-close・google-reviews・invoice-intake・mid-review・ops-bot・secure-state・work-requests
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── 関数を呼んでよいサイト（CORS）──
BC_ALLOWED_ORIGINS=        # bonus-close
GR_ALLOWED_ORIGINS=        # google-reviews
INVOICE_ALLOWED_ORIGINS=   # invoice-intake
MR_ALLOWED_ORIGINS=        # mid-review
SS_ALLOWED_ORIGINS=        # secure-state
WR_ALLOWED_ORIGINS=        # work-requests

# ── 関数どうし・アプリの URL ──
GR_APP_URL=                # google-reviews：つないだあとに戻るアプリの URL
GR_WR_URL=                 # google-reviews：PIN の印を確かめる work-requests の URL
SS_WR_URL=                 # secure-state：PIN の印を確かめる work-requests の URL
INVOICE_APP_URL=           # invoice-intake：Gmail をつないだあとに戻るアプリの URL

# ── Invoice取込（invoice-intake）──
ANTHROPIC_API_KEY=         # invoice の読み取り
INVOICE_AI_MODEL=          # 読み取りに使うモデルの名前（任意）
GOOGLE_OAUTH_CLIENT_ID=    # Drive（drive-sync と同じ接続を使うときは不要）
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GMAIL_OAUTH_CLIENT_ID=     # QuickBooks への原本の転送（Gmail）。google-reviews も使うことがある
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=

# ── Google の口コミ（google-reviews）──
GBP_OAUTH_CLIENT_ID=       # Business Profile
GBP_OAUTH_CLIENT_SECRET=
GBP_OAUTH_REDIRECT_URI=
GOOGLE_PLACES_API_KEY=     # Places（新）

# ── 業務Bot（ops-bot）・知らせ ──
LINE_CHANNEL_ACCESS_TOKEN= # ops-bot・invoice-intake（LINE の知らせ）
LINE_CHANNEL_SECRET=       # ops-bot（受け取りの署名）
TOAST_CLIENT_ID=           # ops-bot（Toast を読む）
TOAST_CLIENT_SECRET=

# ── チャットのプッシュ通知（work-requests）──
CHAT_VAPID_PUBLIC=
CHAT_VAPID_PRIVATE=
CHAT_VAPID_SUBJECT=

# ── このリポジトリに無い関数（auth-pin・hyper-worker など）が使うもの ──
# 名前の一部だけが手順書に出ています。中身は Moto さんに直接渡したファイルを見てください。
# HYPER_WORKER_REQUIRE_SESSION=   # hyper-worker：ログインの印を必須にする（1）

# ── 手元の試験だけで使うもの（任意・秘密ではない）──
# CHROME=          # ヘッドレス Chrome の場所（tests/e2e-* ・tests/perf/*）
# FUNERGY_INDEX=   # 試験で読む index.html の場所（既定はリポジトリの index.html）
